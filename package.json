{
  "name": "umalytics",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:inference": "node scripts/build-inference.mjs",
    "pretest": "node scripts/build-inference.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "bridge": "node scripts/bridge.mjs",
    "start": "node scripts/bridge.mjs",
    "import:race": "node --import tsx scripts/import-race.ts",
    "capture:check": "node scripts/capture-preflight.mjs",
    "capture:inspect": "node scripts/inspect-capture.mjs",
    "test": "node --test tests/system.test.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.3",
    "esbuild": "0.28.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
